@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Reset your password — MT-Uptime</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <img src="@Assets["img/logo_red_gear.png"]" alt="" class="auth-logo" />
        <span>MT&#8209;Uptime</span>
    </div>
    <h1>Reset your password</h1>

    @if (Sent)
    {
        @* Deliberately unconditional: saying "no such address" here would let anyone probe which
           addresses have an account. The same message is shown whether or not mail was sent. *@
        <div class="alert success">
            If that address belongs to an account, a reset link is on its way. The link is valid for one hour.
        </div>
        <p class="muted">
            Nothing arriving? Email delivery needs SendGrid configured with a verified sender. If you cannot
            receive mail, an administrator can reset the account directly on the server — see the deployment
            README.
        </p>
        <p><a href="/login">Back to sign in</a></p>
    }
    else
    {
        <p class="muted">Enter your account's email address and we'll send you a link to set a new password.</p>

        <form method="post" action="/auth/forgot" class="form">
            <AntiforgeryToken />
            <label>Email
                <input name="email" type="email" autocomplete="email" required />
            </label>
            <button type="submit" class="btn">Send reset link</button>
        </form>
        <p class="muted"><a href="/login">Back to sign in</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "sent")] public string? SentFlag { get; set; }
    private bool Sent => !string.IsNullOrEmpty(SentFlag);
}
