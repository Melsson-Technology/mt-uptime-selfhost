@page "/tags"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthPolicies.Editor)]
@inject MT.Uptime.Core.Tags.TagService TagService

<PageTitle>Tags — MT-Uptime</PageTitle>

<div class="page-header">
    <h1>Tags</h1>
</div>

<p class="muted">
    Tags group monitors by environment, customer or host, and drive the dashboard filter. You can create
    one while editing a monitor; this page is for renaming, recolouring and removing them.
    Deleting a tag removes it from every monitor carrying it — the monitors themselves are untouched.
</p>

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

@if (_tags.Count == 0)
{
    <p class="muted">No tags yet. Add one while <a href="/monitors/new">editing a monitor</a>.</p>
}
else
{
    <table class="monitors">
        <thead>
            <tr><th>Tag</th><th>Name</th><th>Colour</th><th>Monitors</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var tag in _tags)
            {
                <tr @key="tag.Id">
                    <td><span class="tag-chip" style="background-color:@tag.Colour">@tag.Name</span></td>
                    <td><input value="@tag.Name" @onchange="e => Rename(tag.Id, e.Value?.ToString())" /></td>
                    <td><input type="color" value="@tag.Colour" @onchange="e => Recolour(tag.Id, e.Value?.ToString())" /></td>
                    <td>@(_counts.TryGetValue(tag.Id, out var n) ? n : 0)</td>
                    <td><button type="button" class="btn-link" @onclick="() => DeleteAsync(tag.Id)">Delete</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Tag> _tags = new();
    private Dictionary<int, int> _counts = new();
    private string? _error;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _tags = await TagService.ListAsync();
        _counts = await TagService.CountsByTagAsync();
    }

    // Name and colour are saved separately because each control commits on its own change event. Both
    // route through UpdateAsync, which needs the other field's current value — so it is read from the
    // loaded row rather than from a second input the user may not have touched.
    private Task Rename(int id, string? name) => SaveAsync(id, name, ColourOf(id));

    private Task Recolour(int id, string? colour) => SaveAsync(id, NameOf(id), colour);

    private async Task SaveAsync(int id, string? name, string? colour)
    {
        _error = await TagService.UpdateAsync(id, name ?? "", colour);
        // Reload either way: on failure the input still shows the rejected value, so the row has to be
        // put back to what the database actually holds.
        await ReloadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        _error = null;
        await TagService.DeleteAsync(id);
        await ReloadAsync();
    }

    private string NameOf(int id) => _tags.FirstOrDefault(t => t.Id == id)?.Name ?? "";
    private string ColourOf(int id) => _tags.FirstOrDefault(t => t.Id == id)?.Colour ?? Tag.DefaultColour;
}
