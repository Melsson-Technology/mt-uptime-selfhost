@page "/reset-password"
@attribute [AllowAnonymous]
@inject UserAccountService Users

<PageTitle>Set a new password — MT-Uptime</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <img src="@Assets["img/logo_red_gear.png"]" alt="" class="auth-logo" />
        <span>MT&#8209;Uptime</span>
    </div>
    <h1>Set a new password</h1>

    @if (!_tokenValid)
    {
        <div class="alert error">
            That reset link is invalid, already used, or has expired. Reset links last one hour.
        </div>
        <p><a href="/forgot-password">Request a new link</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert error">@Error</div>
        }

        <form method="post" action="/auth/reset" class="form">
            <AntiforgeryToken />
            <input type="hidden" name="token" value="@Token" />
            <label>New password
                <input name="password" type="password" autocomplete="new-password" required minlength="8" />
            </label>
            <label>Confirm new password
                <input name="confirm" type="password" autocomplete="new-password" required minlength="8" />
            </label>
            <button type="submit" class="btn">Set password</button>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private bool _tokenValid;

    // Checked on render so an expired or bogus link shows the explanation instead of a form that
    // can only fail on submit.
    protected override async Task OnParametersSetAsync()
        => _tokenValid = !string.IsNullOrWhiteSpace(Token) && await Users.IsResetTokenValidAsync(Token);
}
