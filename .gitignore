# Build output
bin/
obj/
[Bb]uild/
artifacts/
publish/
TestResults/
*.nupkg
*.snupkg

# Rider / VS / VS Code
.vs/
.idea/
.vscode/
*.user
*.suo

# Runtime data — the SQLite database AND the Data Protection keys.
#
# The wildcard matters: a plain `App_Data/` does NOT match sibling copies such as
# `App_Data.bak-2026-01-01/`, and those backups contain the Data Protection master key in
# UNENCRYPTED form. That key decrypts every stored secret (SMTP/API credentials, database
# passwords, webhook URLs) and signs auth cookies, so a stray backup directory is the single
# worst thing that could land in this repository.
**/App_Data*/
*.db
*.db-wal
*.db-shm
*.design.db*

# Python bytecode. The E2E target fixtures under e2e/targets/ are Python, and merely importing or
# byte-compiling one — which `python3 -m py_compile` during development does — drops a __pycache__
# directory next to it. Harmless, but it is build output and it does not belong in a published tree.
__pycache__/
*.py[cod]

# Local tooling config — machine-specific paths, and not useful to anyone else
.claude/settings.local.json

# Logs
*.log

# OS
.DS_Store
Thumbs.db
