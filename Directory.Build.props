<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Identity and licence, stamped into every assembly so a compiled binary carries its own provenance.
    AGPL-3.0-or-later: self-hosting is unrestricted, but offering this to others as a hosted service
    obliges you to publish your modifications.
  -->
  <PropertyGroup>
    <Product>MT-Uptime</Product>
    <Company>Melsson Technology</Company>
    <Authors>Melsson Technology</Authors>
    <Copyright>Copyright (c) 2026 Melsson Technology</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Melsson-Technology/mt-uptime-selfhost</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Melsson-Technology/mt-uptime-selfhost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Nothing packs by default. Only opt a project in if it is genuinely meant to be consumed as a library;
    the host and the test project must never produce a package.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Pin the full dependency graph to packages.lock.json, committed alongside each project.
    Without it, "the same commit" does not mean "the same bytes": floating resolution means a CI build,
    a contributor's build and the release build can each pull a different transitive version, so neither
    a security advisory nor a reproduction can be tied to a commit with any confidence. It also makes a
    dependency change show up as a reviewable diff instead of happening silently at restore time.

    Pass the "locked mode" restore flag in CI to make an out-of-date lock file a build failure rather
    than a silent update.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Declared so the lock files stay the same whichever way you restore.

    Without this, a plain `dotnet build` or `dotnet test` writes lock files with no RID section, while
    build-and-package.sh restores with `-r linux-x64` and adds a `net10.0/linux-x64` entry for the
    native SQLite binary. The two forms overwrite each other, so simply testing and then packaging
    leaves the tree dirty with a diff nobody made — and publish-public.sh, which rightly refuses to run
    against a dirty tree, then blocks on it. Naming the RID here means every restore evaluates it and
    the committed file is the same either way.

    Both RIDs that actually ship are listed. linux-x64 is what build-and-package.sh publishes and what
    deploy/README-deploy.md targets; linux-arm64 is what docker/Dockerfile cross-publishes when
    TARGETARCH is arm64, which is not an optional path — the Raspberry Pi and ARM VPS audience is the
    reason the image is built for two architectures at all. Naming only linux-x64 here would leave the
    lock file without arm64 assets, so an arm64 image build would rewrite it mid-build or, under locked
    mode, fail outright.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
