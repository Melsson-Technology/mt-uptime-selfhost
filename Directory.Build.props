<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Identity and licence, stamped into every assembly so a compiled binary carries its own provenance.
    AGPL-3.0-or-later: self-hosting is unrestricted, but offering this to others as a hosted service
    obliges you to publish your modifications.
  -->
  <PropertyGroup>
    <Product>MT-Uptime</Product>
    <Company>Melsson Technology</Company>
    <Authors>Melsson Technology</Authors>
    <Copyright>Copyright (c) 2026 Melsson Technology</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://git.melssontechnology.com/Melsson-Technology/mt-uptime-selfhost</PackageProjectUrl>
    <RepositoryUrl>https://git.melssontechnology.com/Melsson-Technology/mt-uptime-selfhost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Nothing packs by default. Only opt a project in if it is genuinely meant to be consumed as a library;
    the host and the test project must never produce a package.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Pin the full dependency graph to packages.lock.json, committed alongside each project.
    Without it, "the same commit" does not mean "the same bytes": floating resolution means a CI build,
    a contributor's build and the release build can each pull a different transitive version, so neither
    a security advisory nor a reproduction can be tied to a commit with any confidence. It also makes a
    dependency change show up as a reviewable diff instead of happening silently at restore time.

    Pass the "locked mode" restore flag in CI to make an out-of-date lock file a build failure rather
    than a silent update.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
