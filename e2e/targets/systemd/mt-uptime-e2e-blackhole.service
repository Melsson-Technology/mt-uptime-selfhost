[Unit]
# Drops SYNs to one loopback port, so a monitor can be pointed at something that neither accepts nor
# refuses. That is the only way to exercise the per-check timeout path: a closed port refuses
# instantly, and a listening port accepts instantly — neither ever reaches MonitorRunner's
# CancelAfter, which is where CheckResult.Down("Timeout") is produced.
Description=MT-Uptime E2E TCP blackhole (drop SYNs to the blackhole port)
After=network-online.target
Wants=network-online.target

[Service]
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#  WHY A UNIT OF ITS OWN, RATHER THAN /etc/nftables.conf
#
#  The stock /etc/nftables.conf begins with `flush ruleset`, which deletes EVERY table — including
#  anything ufw or another service on the box installed. Adding our rule there would mean either
#  keeping that flush (and breaking the host's firewall) or removing it (and changing the semantics of
#  a file the operator may reasonably re-apply).
#
#  Our own table, created and destroyed by this unit, touches nothing else. `nft delete table` before
#  `nft add table` is the idiom that makes the start idempotent — nft has no "create or replace" — and
#  the leading `-` on that line lets it fail harmlessly the first time, when there is nothing to
#  delete.
#
#  WHY drop AND NOT reject
#
#  reject sends an RST or an ICMP unreachable, which the client sees as an immediate refusal — exactly
#  what the closed port already tests. Only drop produces silence, and only silence produces a timeout.
#
#  WHY NOT AN UNROUTABLE ADDRESS INSTEAD
#
#  Pointing a monitor at TEST-NET-1 (192.0.2.0/24) would need no nft, no root and no unit, and it was
#  seriously considered. Measured, connect() to 192.0.2.1 fails INSTANTLY with ENETUNREACH on a host
#  with filtered egress, and would presumably hang on a normal VPC. Whether unroutable space hangs or
#  fails fast is a property of the network rather than of the address, so it would make this test
#  environment-dependent — a flake indistinguishable from a product bug. A local drop rule is
#  deterministic.
# ─────────────────────────────────────────────────────────────────────────────────────────────────
Type=oneshot

# The rule outlives the invocation; without this systemd considers a oneshot with no remaining
# processes to be inactive, and `systemctl is-active` — which the self-check asserts on — says
# "inactive" for a unit that is doing its job.
RemainAfterExit=yes

EnvironmentFile=/etc/mt-uptime-e2e/blackhole.env

ExecStart=-/usr/sbin/nft delete table inet mt_uptime_e2e
ExecStart=/usr/sbin/nft add table inet mt_uptime_e2e
ExecStart=/usr/sbin/nft add chain inet mt_uptime_e2e input { type filter hook input priority -10 ; policy accept ; }
ExecStart=/bin/sh -c '/usr/sbin/nft add rule inet mt_uptime_e2e input tcp dport $E2E_TCP_BLACKHOLE_PORT drop'

ExecStop=-/usr/sbin/nft delete table inet mt_uptime_e2e

# priority -10 puts this chain ahead of the filter hooks ufw and docker install at priority 0, so the
# drop applies whatever else is on the box. It is scoped to one destination port on one machine, so
# running ahead of the host's firewall costs nothing.

[Install]
WantedBy=multi-user.target
