# /etc/mt-uptime/backup.env — where this instance's backups go.
#
# Copy to /etc/mt-uptime/backup.env, fill in, and chmod 0600. Read by BOTH the nightly backup unit and
# a restore run by hand, so a restore always looks in the same place the backup wrote to.
#
# Leave S3_BUCKET unset for a local-only backup. That still gives you a verified archive with the key
# ring in it, and it protects you from a bad migration and NOT from losing the disk — the script says
# so on every run rather than letting you assume otherwise.

S3_BUCKET=my-mt-uptime-backups
S3_PREFIX=engine
AWS_REGION=us-east-1

# The AWS credential itself goes in /etc/mt-uptime/aws-credentials (0600, root-only), in the standard
# shared-credentials format. NOT in /root/.aws — the unit sets ProtectHome=true, which hides /root from
# it, and the resulting error names permissions rather than the real cause.
#
#     [default]
#     aws_access_key_id = ...
#     aws_secret_access_key = ...
#
# Give that user s3:PutObject, s3:GetObject and s3:ListBucket on the bucket, and DO NOT give it
# s3:DeleteObject: expiry belongs to a bucket lifecycle policy, and a machine that can erase its own
# backups is a machine whose backups a compromise can erase.
