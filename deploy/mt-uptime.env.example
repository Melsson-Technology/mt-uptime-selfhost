# Optional systemd EnvironmentFile for MT-Uptime, installed at /etc/mt-uptime/mt-uptime.env
# and referenced with `EnvironmentFile=-/etc/mt-uptime/mt-uptime.env` via `systemctl edit mt-uptime`.
#
# HOSTING KNOBS ONLY — never application secrets.
#
# The SendGrid API key, monitored-database passwords, webhook URLs and bot tokens are entered in the
# UI and stored ENCRYPTED in the database, using keys under Storage__DataProtectionKeysPath. Putting
# any of them here would move them from encrypted-at-rest into a plaintext file, which is the opposite
# of what the design is for.

# Environment. Leave as Production unless you are debugging.
ASPNETCORE_ENVIRONMENT=Production

# Kestrel binds loopback only; nginx terminates TLS and proxies to it. Do not bind 0.0.0.0 unless you
# have removed the reverse proxy and understand that ForwardedHeaders then trusts spoofable client IPs.
#
# 5081 rather than the ASP.NET Core default of 5000, which is usually already taken on a shared host.
# Confirm nothing holds it here either — `ss -ltnp | grep :5081` — and change BOTH this line and the
# `proxy_pass` in the nginx site if you move it.
ASPNETCORE_URLS=http://127.0.0.1:5081

# Where the SQLite database and the Data Protection keys live. Both must be on persistent storage and
# both must be backed up together — the keys decrypt the secrets stored in the database, so a backup of
# one without the other is not a backup.
Storage__DatabasePath=/var/lib/mt-uptime/mt-uptime.db
Storage__DataProtectionKeysPath=/var/lib/mt-uptime/keys

# --- Engine tuning (optional; sensible defaults apply if unset) ---

# Cap on simultaneous checks across all monitors. Unset = auto, clamp(cores * 4, 8, 32).
# Engine__MaxConcurrentChecks=16

# Days of raw heartbeats to keep before they are rolled up into hourly/daily buckets and pruned.
# Long-range uptime percentages survive pruning, so this mainly trades disk for per-check detail.
# Engine__RawRetentionDays=30

# Days of hourly rollups to keep. Daily rollups are kept indefinitely — they are one tiny row per day.
# Engine__HourlyRetentionDays=180

# Workstation GC keeps memory small on a 1 vCPU / 1 GB instance. Remove on a larger box.
DOTNET_gcServer=0
