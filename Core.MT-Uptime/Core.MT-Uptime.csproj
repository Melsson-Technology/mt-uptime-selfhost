<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      The project folder is named for its role (Role.MT-Uptime), but the assembly and namespace keep
      the idiomatic .NET form. Decoupling them here is what let the restructure happen without
      touching a single source file or `using` directive.
    -->
    <AssemblyName>MT.Uptime.Core</AssemblyName>
    <RootNamespace>MT.Uptime.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!--
      EF Core 10.0.10 pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.11, whose native lib carries SQLite
      < 3.50.2 and so trips NU1903 (CVE-2025-6965). Bundle 2.1.12 is the maintenance release that
      moves the native lib to SQLite 3.53.3; pin it here until EF Core ships a patched transitive.
      Web and Tests inherit this through their ProjectReference to Core.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- RedactingHttpClientLogger is an implementation detail, not public API, but it is the thing
         standing between a webhook credential and the system log — so it needs real tests. Exposing
         internals to the test assembly is preferable to widening the published surface for testability. -->
    <InternalsVisibleTo Include="MT.Uptime.Tests" />
  </ItemGroup>

</Project>
