# Normalize line endings so a repository developed on Windows still works on macOS and Linux.
#
# The critical rule is the one for *.sh: a shell script checked out with CRLF endings fails on Linux
# with "bad interpreter: /usr/bin/env bash^M", which is a confusing way to discover a line-ending
# problem. The deploy scripts run on the server, so they must always be LF regardless of who committed
# them or from which platform.

# Store everything as LF in the repository; check out native on Windows unless overridden below.
* text=auto

# Always LF — these are executed by Linux shells or read by Linux tooling.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.conf.sample   text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Always CRLF — PowerShell on Windows is happiest this way and never runs on a Linux shell.
*.ps1           text eol=crlf

# Explicit text types (helps diffing and avoids mis-detection)
*.cs            text
*.razor         text
*.csproj        text
*.slnx          text
*.props         text
*.json          text
*.css           text
*.md            text

# Binary — never touch these
*.png           binary
*.jpg           binary
*.ico           binary
*.gz            binary
*.zip           binary
