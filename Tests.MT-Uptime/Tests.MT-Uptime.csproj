<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>MT.Uptime.Tests</AssemblyName>
    <RootNamespace>MT.Uptime.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.MT-Uptime\Core.MT-Uptime.csproj" />
    <!-- For UserAccountService (the account/reset-token logic lives in the host because it depends on
         ASP.NET Core Identity's password hasher) and for WebApplicationFactory<Program>, which boots the
         real pipeline so endpoint authorization can be tested. -->
    <ProjectReference Include="..\SelfHost.MT-Uptime\SelfHost.MT-Uptime.csproj" />
  </ItemGroup>

</Project>